// Native UI backed by Steam membership and per-round member votes, not LIVE.
menuDef
{
    name "csl_steam_lobby"
    rect 0 0 640 480
    fullScreen 1
    visible 1
    onEsc { exec "steam_lobby_leave"; }
    itemDef { name "panel" rect 0 0 640 480 style 1 backcolor 0.035 0.055 0.075 0.96 visible 1 decoration }
    itemDef { name "banner" rect 0 46 640 42 style 1 backcolor 0.85 0.36 0.04 0.85 visible 1 decoration }
    itemDef { name "title" rect 30 55 580 30 text "PROJECT: CONSOLATION / MATCH LOBBY" font 1 textscale 0.4 forecolor 1 1 1 1 visible 1 decoration }
    itemDef { name "state" rect 30 98 580 26 text "Preparing lobby..." font 1 textscale 0.3 forecolor 0.9 0.9 0.9 1 visible 1 decoration }
    itemDef { name "vote_title" rect 30 136 580 24 text "VOTE FOR THE NEXT MATCH" font 1 textscale 0.3 forecolor 0.95 0.75 0.3 1 visible 1 decoration }
    itemDef { name "vote0" rect 30 165 580 30 text "Option 1" font 1 textscale 0.32 forecolor 1 1 1 1 type ITEM_TYPE_BUTTON visible 1 action { exec "steam_match_vote 1"; } }
    itemDef { name "vote1" rect 30 200 580 30 text "Option 2" font 1 textscale 0.32 forecolor 1 1 1 1 type ITEM_TYPE_BUTTON visible 1 action { exec "steam_match_vote 2"; } }
    itemDef { name "member0" rect 30 248 270 17 text "" font 1 textscale 0.24 forecolor 1 1 1 1 visible 1 decoration }
    itemDef { name "member1" rect 30 266 270 17 text "" font 1 textscale 0.24 forecolor 1 1 1 1 visible 1 decoration }
    itemDef { name "member2" rect 30 284 270 17 text "" font 1 textscale 0.24 forecolor 1 1 1 1 visible 1 decoration }
    itemDef { name "member3" rect 30 302 270 17 text "" font 1 textscale 0.24 forecolor 1 1 1 1 visible 1 decoration }
    itemDef { name "member4" rect 30 320 270 17 text "" font 1 textscale 0.24 forecolor 1 1 1 1 visible 1 decoration }
    itemDef { name "member5" rect 30 338 270 17 text "" font 1 textscale 0.24 forecolor 1 1 1 1 visible 1 decoration }
    itemDef { name "member6" rect 30 356 270 17 text "" font 1 textscale 0.24 forecolor 1 1 1 1 visible 1 decoration }
    itemDef { name "member7" rect 30 374 270 17 text "" font 1 textscale 0.24 forecolor 1 1 1 1 visible 1 decoration }
    itemDef { name "member8" rect 30 392 270 17 text "" font 1 textscale 0.24 forecolor 1 1 1 1 visible 1 decoration }
    itemDef { name "member9" rect 330 248 280 17 text "" font 1 textscale 0.24 forecolor 1 1 1 1 visible 1 decoration }
    itemDef { name "member10" rect 330 266 280 17 text "" font 1 textscale 0.24 forecolor 1 1 1 1 visible 1 decoration }
    itemDef { name "member11" rect 330 284 280 17 text "" font 1 textscale 0.24 forecolor 1 1 1 1 visible 1 decoration }
    itemDef { name "member12" rect 330 302 280 17 text "" font 1 textscale 0.24 forecolor 1 1 1 1 visible 1 decoration }
    itemDef { name "member13" rect 330 320 280 17 text "" font 1 textscale 0.24 forecolor 1 1 1 1 visible 1 decoration }
    itemDef { name "member14" rect 330 338 280 17 text "" font 1 textscale 0.24 forecolor 1 1 1 1 visible 1 decoration }
    itemDef { name "member15" rect 330 356 280 17 text "" font 1 textscale 0.24 forecolor 1 1 1 1 visible 1 decoration }
    itemDef { name "member16" rect 330 374 280 17 text "" font 1 textscale 0.24 forecolor 1 1 1 1 visible 1 decoration }
    itemDef { name "member17" rect 330 392 280 17 text "" font 1 textscale 0.24 forecolor 1 1 1 1 visible 1 decoration }
    itemDef { name "start" rect 30 434 190 30 text "START MATCH (HOST)" font 1 textscale 0.3 forecolor 1 1 1 1 type ITEM_TYPE_BUTTON visible 1 action { exec "steam_match_start"; } }
    itemDef { name "invite" rect 250 434 160 30 text "INVITE FRIENDS" font 1 textscale 0.3 forecolor 1 1 1 1 type ITEM_TYPE_BUTTON visible 1 action { exec "steam_lobby_invite"; } }
    itemDef { name "leave" rect 450 434 160 30 text "LEAVE LOBBY" font 1 textscale 0.3 forecolor 1 1 1 1 type ITEM_TYPE_BUTTON visible 1 action { exec "steam_lobby_leave"; } }
}
