<Application x:Class="Consolation.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Base" Color="#18181B" />
    <SolidColorBrush x:Key="Panel" Color="#222225" />
    <SolidColorBrush x:Key="Card" Color="#2B2B2F" />
    <SolidColorBrush x:Key="Stroke" Color="#3A383D" />
    <SolidColorBrush x:Key="Muted" Color="#A6A1AA" />
    <SolidColorBrush x:Key="Accent" Color="#952F48" />
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#EEEAF0" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EEEAF0" />
      <Setter Property="Background" Value="{StaticResource Card}" />
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#F2CED6" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Navigation" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="Margin" Value="12,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Tile" CornerRadius="12" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="8,12">
              <ContentPresenter HorizontalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Tile" Property="Background" Value="#42222C" />
                <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="#363037" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="#F2CED6" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#EEEAF0" />
      <Setter Property="Background" Value="{StaticResource Base}" />
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="CaretBrush" Value="White" />
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#EEEAF0" />
      <Setter Property="Margin" Value="0,12,0,0" />
    </Style>
  </Application.Resources>
</Application>
