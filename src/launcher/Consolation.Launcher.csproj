<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x86</Platforms>
    <PlatformTarget>x86</PlatformTarget>
    <AssemblyName>Consolation.Launcher</AssemblyName>
    <RootNamespace>Consolation.Launcher</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../../required_files/icon.ico</ApplicationIcon>
    <BaseOutputPath>../../build/launcher/bin/</BaseOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="../../required_files/icon.ico" Link="Assets/icon.ico" />
    <Resource Include="Assets/*.png" />
    <Content Include="../../required_files/Check Consolation Updates.ps1" Link="Support/Check Consolation Updates.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
