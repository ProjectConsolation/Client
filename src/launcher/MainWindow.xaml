<Window x:Class="Consolation.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Project: Consolation - Launcher" Width="1080" Height="700" MinWidth="880" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Base}" Foreground="#EEEAF0" FontFamily="Segoe UI" FontSize="14"
        Icon="Assets/icon.ico" Closing="Window_Closing" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0" />
  </shell:WindowChrome.WindowChrome>
  <Border Background="{StaticResource Base}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /><RowDefinition Height="44" /></Grid.RowDefinitions>
      <Border Background="{StaticResource Base}">
        <Grid Margin="18,0,12,0">
          <TextBlock Text="PROJECT: CONSOLATION - LAUNCHER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize" Background="Transparent" BorderThickness="0" Padding="9">
              <Ellipse Width="12" Height="12" Fill="#D8AC51" />
            </Button>
            <Button Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close" Background="Transparent" BorderThickness="0" Padding="9">
              <Ellipse Width="12" Height="12" Fill="#D65C65" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Base}">
          <DockPanel Margin="0,18,0,16">
            <StackPanel DockPanel.Dock="Bottom">
              <RadioButton x:Name="SettingsNavigation" Style="{StaticResource Navigation}" GroupName="Page" Tag="Settings" Checked="Navigate_Checked" AutomationProperties.Name="Settings">
                <StackPanel><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="Settings" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center" /></StackPanel>
              </RadioButton>
            </StackPanel>
            <StackPanel>
              <RadioButton x:Name="PlayNavigation" Style="{StaticResource Navigation}" GroupName="Page" Tag="Play" Checked="Navigate_Checked" AutomationProperties.Name="Multiplayer">
                <StackPanel><TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="Play" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center" /></StackPanel>
              </RadioButton>
              <RadioButton Style="{StaticResource Navigation}" GroupName="Page" Tag="Community" Checked="Navigate_Checked" AutomationProperties.Name="Community">
                <StackPanel><TextBlock Text="&#xE902;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="Community" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center" /></StackPanel>
              </RadioButton>
              <Button Tag="InstallGuide" Click="Link_Click" Background="Transparent" BorderThickness="0" Padding="3,8" Margin="8,2" FontSize="11">
                <StackPanel HorizontalAlignment="Center"><Viewbox Width="24" Height="24" HorizontalAlignment="Center"><Path Data="M 4,2 L 19,2 L 19,22 L 4,22 C 1,22 1,17 4,17 L 19,17 M 5,6 L 15,6 M 5,9 L 15,9" Stroke="#EEEAF0" StrokeThickness="1.6" Fill="Transparent" /></Viewbox><TextBlock Text="Install guide" Margin="0,8,0,0" HorizontalAlignment="Center" /></StackPanel>
              </Button>
              <Button Tag="Donate" Click="Link_Click" Background="Transparent" BorderThickness="0" Padding="3,8" Margin="8,2" FontSize="11">
                <StackPanel><TextBlock Text="&#xEB52;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center" Foreground="#D8A9B6" /><TextBlock Text="Donate" Margin="0,8,0,0" HorizontalAlignment="Center" /></StackPanel>
              </Button>
            </StackPanel>
          </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="28,24">
          <Grid x:Name="PlayPage">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" /><RowDefinition Height="*" />
              <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
              <Grid Margin="0,0,0,16">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Welcome" FontSize="24" FontWeight="SemiBold" />
                  <TextBlock Grid.Row="1" Grid.ColumnSpan="2" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,8,0,0" MaxWidth="650" HorizontalAlignment="Left"><Run Text="A work-in-progress project aimed at extending and improving the multiplayer PC experience of " /><Hyperlink Click="GameInfo_Click" Foreground="#D8A9B6">007: Quantum of Solace</Hyperlink></TextBlock>
                <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#30262B" CornerRadius="5" Padding="10,6"><TextBlock Text="EXPERIMENTAL CLIENT" FontSize="10" Foreground="#D8A9B6" /></Border>
              </Grid>
              <Border Grid.Row="1" x:Name="HeroArt" ClipToBounds="True" BorderThickness="0" MaxHeight="270">
                <Grid Background="Black" ClipToBounds="True">
                  <!-- Match the source's 768:480 aspect ratio instead of
                       enlarging then cropping it into the banner height. -->
                  <Viewbox HorizontalAlignment="Right" Stretch="Uniform" StretchDirection="DownOnly">
                  <Image Source="Assets/jb.png" Width="432" Height="270" Stretch="Uniform" RenderOptions.BitmapScalingMode="Fant" SnapsToDevicePixels="True">
                    <Image.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00000000" Offset="0" /><GradientStop Color="#00000000" Offset="0.56" /><GradientStop Color="Black" Offset="0.69" /></LinearGradientBrush></Image.OpacityMask>
                  </Image>
                  </Viewbox>
                  <Border IsHitTestVisible="False"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0" /><GradientStop Color="#00000000" Offset="0.65" /><GradientStop Color="#A0000000" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                  <Image Source="Assets/logo_csl.png" Stretch="Uniform" Width="350" MaxHeight="150" Margin="26,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Project Consolation" />
                </Grid>
              </Border>
              <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10" BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="18" Margin="0,14,0,0">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Multiplayer" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Foreground="{StaticResource Muted}" Margin="0,8,0,0"><Run Text="Steam matchmaking &amp; P2P." /><LineBreak /><Run Text="System Link is available in-game as a non-Steam fallback." /></TextBlock>
                    <TextBlock x:Name="InstallStatus" Text="Choose your game folder in Settings." Foreground="#D4AFBA" Margin="0,14,0,0" FontSize="12" />
                    <TextBlock x:Name="BuildStatus" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
                    <TextBlock x:Name="SteamStatus" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
                    <TextBlock x:Name="NightlyStatus" FontSize="11" Foreground="#D4AFBA" Margin="0,6,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button x:Name="PlayButton" Content="PLAY  &#x2192;" FontSize="16" FontWeight="SemiBold" Background="{StaticResource Accent}" BorderBrush="#BA526D" Padding="20,15" Click="Play_Click" />
                    <CheckBox x:Name="SkipUpdatesBox" Content="Skip updates (-noupdate)" FontSize="11" HorizontalAlignment="Center" Checked="SkipUpdates_Changed" Unchecked="SkipUpdates_Changed" />
                    <Button x:Name="UpdateButton" Content="Check for updates" Margin="0,10,0,0" Click="Update_Click" FontSize="12" />
                  </StackPanel>
                </Grid>
              </Border>
              <Border x:Name="OfflineNameReminder" Grid.Row="3" Visibility="Collapsed" Background="#30262B" CornerRadius="6" Padding="12,9" Margin="0,10,0,0">
                <TextBlock FontSize="12" Foreground="#E8C8D0"><Run Text="Steam isn't running. Please set your player name in " /><Hyperlink Click="NameSettings_Click" Foreground="#F2CED6">Settings</Hyperlink><Run Text=" before playing, or use name &quot;YourName&quot; in the in-game console." /></TextBlock>
              </Border>
          </Grid>
          <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold" />
              <TextBlock Text="Your installation. Your launch preferences." Foreground="{StaticResource Muted}" Margin="0,6,0,24" />
              <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="24">
                <StackPanel>
                  <TextBlock Text="Game directory" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Select the folder containing JB_Launcher_s.exe, d3d9.dll and xlive.dll." Foreground="{StaticResource Muted}" Margin="0,8,0,14" />
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox x:Name="GameDirectoryBox" IsReadOnly="True" AutomationProperties.Name="Game directory" />
                    <Button Grid.Column="1" Content="Browse…" Margin="10,0,0,0" Click="Browse_Click" />
                  </Grid>
                  <CheckBox x:Name="CheckUpdatesBox" Content="Check for client updates before playing (off: -noupdate)" IsChecked="True" Checked="CheckUpdates_Changed" Unchecked="CheckUpdates_Changed" />
                  <TextBlock Text="The launcher exits automatically after starting the game." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,14,0,0" />
                  <Button Content="Save settings" Click="Save_Click" HorizontalAlignment="Left" Background="{StaticResource Accent}" Margin="0,22,0,0" />
                </StackPanel>
              </Border>
              <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="24" Margin="0,18,0,0">
                <StackPanel>
                  <TextBlock Text="Launch options" FontSize="18" FontWeight="SemiBold" />
                  <CheckBox x:Name="SkipIntroBox" Content="Skip intro movies" IsChecked="True" Checked="Preference_Changed" Unchecked="Preference_Changed" />
                  <TextBlock Text="Diagnostics · leave off for normal play" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,20,0,0" />
                  <CheckBox x:Name="DebugAssetsBox" Content="Asset-loading diagnostics (-debug_xasset)" Checked="Preference_Changed" Unchecked="Preference_Changed" />
                  <CheckBox x:Name="TraceActionsBox" Content="Scaleform action tracing (-scaleform-actions)" Checked="Preference_Changed" Unchecked="Preference_Changed" />
                  <TextBlock Text="Offline player name (name dvar)" Margin="0,22,0,8" />
                  <TextBox x:Name="PlayerNameBox" MaxLength="15" AutomationProperties.Name="Offline player name" ToolTip="Leave blank to retain your existing name. Up to 15 ASCII characters." />
                  <TextBlock x:Name="PlayerNameStatus" Text="Checking Steam…" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0" />
                  <Button Content="Save launch options" Click="Save_Click" HorizontalAlignment="Left" Background="{StaticResource Accent}" Margin="0,20,0,0" />
                </StackPanel>
              </Border>
              <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="24" Margin="0,18,0,0">
                <StackPanel>
                  <TextBlock Text="Repair installation" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="Reinstall client files from the latest nightly. Your original game files must already be installed." Foreground="{StaticResource Muted}" Margin="0,10,0,14" />
                  <Button x:Name="RepairButton" Content="Repair client files" Click="Repair_Click" HorizontalAlignment="Left" />
                  <TextBlock Text="Restore previously replaced client files. Added files are kept. Only complete, verified backups from this updater are supported." Foreground="{StaticResource Muted}" Margin="0,20,0,10" />
                  <ListBox x:Name="BackupList" DisplayMemberPath="Label" MinHeight="60" MaxHeight="120" Background="{StaticResource Base}" Foreground="#EEEAF0" BorderBrush="{StaticResource Stroke}" Padding="6" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Client backups" />
                  <WrapPanel Margin="0,10,0,0">
                    <Button Content="Refresh backups" Click="Backups_Click" Margin="0,0,10,0" />
                    <Button Content="Restore selected backup" Click="Restore_Click" />
                    <Button Content="Open logs" Click="Logs_Click" Margin="10,0,0,0" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="24" Margin="0,18,0,0">
                <StackPanel><TextBlock Text="Steam &amp; offline play" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="For online play, open Steam and sign in before launching. Without Steam, use SYSTEM LINK in-game. Both modes require the bundled xlive.dll. This launcher does not sign in, store your Steam credentials or change your game profile." Foreground="{StaticResource Muted}" Margin="0,10,0,0" /></StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
          <ScrollViewer x:Name="CommunityPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Stay in the loop." FontSize="28" FontWeight="SemiBold" />
              <TextBlock Text="Follow the project, get set up, or share what you find." Foreground="{StaticResource Muted}" Margin="0,6,0,24" />
              <Border Background="{StaticResource Panel}" CornerRadius="10" Padding="24">
                <StackPanel>
                  <TextBlock Text="Project: Consolation" FontSize="22" FontWeight="SemiBold" />
                  <TextBlock Text="Client upkeep, Steam multiplayer and ongoing map-conversion work. Test zones remain works in progress, with no release date planned." Foreground="{StaticResource Muted}" Margin="0,12,0,20" />
                  <WrapPanel>
                    <Button Content="Development log" Tag="Devlog" Click="Link_Click" Margin="0,0,10,10" Background="{StaticResource Accent}" />
                    <Button Content="Setup &amp; wiki" Tag="Wiki" Click="Link_Click" Margin="0,0,10,10" />
                    <Button Content="GitHub" Tag="Source" Click="Link_Click" Margin="0,0,10,10" />
                    <Button Content="Discord" Tag="Discord" Click="Link_Click" Margin="0,0,10,10" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <TextBlock Text="Links open in your default browser." Foreground="{StaticResource Muted}" Margin="2,18,0,0" FontSize="12" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
      <Border Grid.Row="2" Background="{StaticResource Base}" Padding="18,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="Ready." FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            <ProgressBar x:Name="UpdateProgress" Height="5" Margin="0,5,0,0" Visibility="Collapsed" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}" Background="#373137" />
          </StackPanel>
          <Button x:Name="CancelUpdateButton" Grid.Column="1" Content="Cancel download" Click="CancelUpdate_Click" Visibility="Collapsed" Margin="12,0,0,0" FontSize="11" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
